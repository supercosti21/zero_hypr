# =============================================================================
#  mako — demone di notifica.
#  Comandi utili:  makoctl dismiss --all     chiude tutto
#                  makoctl mode -t do-not-disturb   silenzia / riattiva
#                  makoctl restore           riapre l'ultima chiusa
# =============================================================================

font=MesloLGS Nerd Font 11
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

border-size=2
border-radius=12
padding=14
margin=8
default-timeout=6000
ignore-timeout=0

width=380
height=160
max-visible=5

anchor=top-right
outer-margin=44,12,0,0

icons=1
max-icon-size=48
icon-location=left

markup=1
format=<b>%s</b>\n%b
actions=1
layer=overlay

# --- Notifiche urgenti: restano finche' non le chiudi ---
[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

[urgency=low]
border-color=#45475a
text-color=#a6adc8
default-timeout=4000

# --- Modalita' "non disturbare": SUPER+N la attiva/disattiva ---
[mode=do-not-disturb]
invisible=1

# Anche in non-disturbare, batteria scarica e simili passano comunque.
[mode=do-not-disturb urgency=critical]
invisible=0
